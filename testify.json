{
  "srcDirs": [
    "./projects/libraries/coroutines/src/lib"
  ],
  "testDirs": [
    "./projects/libraries/coroutines/src/tests"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "preserveOutputs": false,
  "outDir": "dist/.vite-jasmine-build",
  "browser": "chrome",
  "headless": false,
  "coverage": false,
  "port": 8888,
  "viteBuildOptions": {
    "target": "es2022",
    "sourcemap": true,
    "minify": false,
    "preserveModules": false,
    "preserveModulesRoot": "."
  },
  "jasmineConfig": {
    "env": {
      "stopSpecOnExpectationFailure": false,
      "random": true,
      "seed": 0,
      "timeout": 120000
    }
  },
  "htmlOptions": {
    "title": "Jasmine Test Runner",
    "preludeModules": []
  },
  "suppressConsoleLogs": false
}